{
  "expo": {
    "plugins": [
      "@react-native-firebase/app",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/near_rides.mpeg",
            "./assets/sound2.mpeg"
          ]
        }
      ],
      "./plugins/withTrustOverlay",
      "./plugins/withDisableNetworkInspector",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trust Express uses your location while the app is open to set pickup points, find nearby drivers, and show live ride progress.",
          "locationAlwaysAndWhenInUsePermission": "While you are online as a driver, Trust Express uses your location in the background so you receive ride requests near where you are, even when the app is closed.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Trust Express to use Face ID to sign you in.",
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "name": "Trust Express",
    "slug": "trust-express",
    "version": "3.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "trustexpress",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#206EFF"
    },
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.tatenda10.trustexpress",
      "config": {
        "googleMapsApiKey": "AIzaSyAFvd2lhakPBSdDoBw8rVlA2Q4HcUnLSIc"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyALiawY2GIvcMYuW6EIfKqqc2f8vdGdSsw"
        }
      },
      "permissions": [
        "VIBRATE",
        "USE_BIOMETRIC",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "USE_FULL_SCREEN_INTENT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.tatenda10.trustexpress"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "ea348ba3-a2a2-4924-882c-6fbc5eb8384c"
      }
    }
  }
}
