CLERK_SECRET_KEY=sk_test_xxxx
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trust_express
PORT=3001

# Google Maps (Places autocomplete/details fallback after OSM).
# Enable Places API on this key in Google Cloud Console.
GOOGLE_MAPS_API_KEY=
HERE_API_KEY=

# Firebase Admin (optional – phone verification for drivers)
# Service account JSON path or inline JSON. Enable Phone sign-in in Firebase Console.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
# Or: FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Paystack (driver wallet top-ups)
PAYSTACK_SECRET_KEY=sk_test_xxxx

# Smile&Pay / ZB Bank (driver wallet top-ups)
# Sandbox merchant portal: https://zbnet.zb.co.zw/wallet_sandbox_merchant/
SMILEPAY_ENVIRONMENT=sandbox
SMILEPAY_API_KEY=
SMILEPAY_API_SECRET=
# Public API origin used for Smile&Pay resultUrl webhooks
PUBLIC_API_BASE_URL=https://your-api.example.com

# Optional default wallet provider: paystack | smilepay
# DRIVER_WALLET_PAYMENT_PROVIDER=paystack
